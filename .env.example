# ─────────────────────────────────────────────────────────────────────────────
# AI Support Triage Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local (Docker): postgresql://postgres:postgres@localhost:5432/ai_support_triage
# Production (Supabase): get from Supabase dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_support_triage

# ── REDIS ─────────────────────────────────────────────────────────────────────
# Local (Docker): redis://localhost:6380
# Production (Upstash): rediss://:<password>@<host>:6380  (note: rediss:// with TLS)
REDIS_URL=redis://localhost:6380

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── GEMINI AI ─────────────────────────────────────────────────────────────────
# Get from: aistudio.google.com → API Keys (free tier: 1500 req/day)
GEMINI_API_KEY=your_gemini_api_key

# ── EMAIL — GMAIL SMTP ────────────────────────────────────────────────────────
# Use a Gmail account + App Password (not your main password)
# Enable: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── BACKEND SERVER ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Password reset token expiry (in minutes)
RESET_TOKEN_EXPIRES_MINUTES=30

# AI confidence threshold below which tickets get escalated (0-100)
DEFAULT_CONFIDENCE_THRESHOLD=70

# ── FRONTEND (Next.js) ────────────────────────────────────────────────────────
# These are exposed to the browser — DO NOT put secrets here
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
